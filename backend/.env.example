PORT=3000
MONGODB_URI=mongodb://localhost:27017/typeshitcode
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Anthropic (Claude AI) — classificação de produtos do recibo
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Places API
GOOGLE_PLACES_API_KEY=

# Google Cloud Document AI
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Caminho para o ficheiro JSON de credenciais do Google Cloud
# Obtido em: Google Cloud Console → IAM & Admin → Service Accounts → Chaves
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
