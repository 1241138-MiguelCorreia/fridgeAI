{
  "expo": {
    "name": "Fresko",
    "slug": "fresko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fresko.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-transparente.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fresko.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A app precisa de acesso à galeria para ler fotos de recibos.",
          "cameraPermission": "A app precisa de acesso à câmera para fotografar recibos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A app precisa da tua localização para encontrar supermercados e mercados perto de ti."
        }
      ]
    ],
    "scheme": "fresko",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
